%% Style rules enforced by `rebar3 lint'. This is a curated subset of the
%% default elvis ruleset: rules that catch real problems and that the code
%% is expected to satisfy. Formatting proper is erlfmt's job (`make format'),
%% so purely cosmetic rules are left out to avoid two tools disagreeing.
[
    {elvis, [
        {config, [
            #{
                dirs => ["src"],
                filter => "*.erl",
                ruleset => erl_files,
                rules => [
                    {elvis_style, line_length, #{limit => 100}},
                    {elvis_style, no_tabs},
                    {elvis_style, no_trailing_whitespace},
                    {elvis_style, macro_names},
                    {elvis_style, operator_spaces},
                    {elvis_style, no_if_expression},
                    {elvis_style, no_nested_try_catch},
                    {elvis_style, used_ignored_variable},
                    {elvis_style, no_behavior_info},
                    {elvis_style, module_naming_convention, #{regex => "^[a-z][a-z0-9_]*$"}},
                    {elvis_style, function_naming_convention, #{regex => "^[a-z][a-z0-9_]*$"}},
                    {elvis_style, variable_naming_convention, #{regex => "^([A-Z][0-9a-zA-Z]*)$"}},
                    {elvis_style, consistent_variable_casing},
                    {elvis_style, no_catch_expressions},
                    %% `apply/3' on a registered handler is the entire point of
                    %% the dispatcher, so dynamic calls are expected in it.
                    {elvis_style, invalid_dynamic_call, #{
                        ignore => [json_rpc_dispatcher]
                    }},
                    {elvis_style, max_function_arity, #{max_arity => 5}},
                    {elvis_style, param_pattern_matching, #{side => right}}
                ]
            },
            #{
                dirs => ["test"],
                filter => "*.erl",
                ruleset => erl_files,
                rules => [
                    {elvis_style, line_length, #{limit => 100}},
                    {elvis_style, no_tabs},
                    {elvis_style, no_trailing_whitespace},
                    {elvis_style, operator_spaces},
                    {elvis_style, used_ignored_variable}
                ]
            },
            #{
                dirs => ["."],
                filter => "rebar.config",
                ruleset => rebar_config
            }
        ]}
    ]}
].
