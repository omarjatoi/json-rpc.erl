{erl_opts, [
    debug_info,
    warnings_as_errors,
    warn_unused_import,
    warn_unused_vars,
    warn_shadow_vars,
    warn_obsolete_guard,
    warn_export_vars
]}.

%% JSON encoding/decoding uses `json' from OTP's stdlib (OTP 27+), so the
%% library has no native (NIF) dependency at all.
{minimum_otp_vsn, "27"}.

{deps, [
    {cowboy, "2.17.0"},
    {telemetry, "1.4.2"}
]}.

{project_plugins, [
    {rebar3_lint, "~> 4.1"},
    {rebar3_ex_doc, "~> 0.2"}
]}.

{profiles, [
    {test, [
        {erl_opts, [debug_info, nowarn_export_all]},
        {deps, [{gun, "2.2.0"}]}
    ]}
]}.

{dialyzer, [
    {warnings, [error_handling, unknown, unmatched_returns, no_improper_lists]},
    {plt_apps, top_level_deps},
    {plt_extra_apps, [erts, kernel, stdlib, cowboy, cowlib, ranch, telemetry]}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls
]}.

{ct_opts, [{keep_logs, 5}]}.

{cover_enabled, true}.
{cover_opts, [verbose]}.
{cover_excl_mods, [json_rpc_test_methods]}.

{ex_doc, [
    {extras, [<<"README.md">>, <<"LICENSE.md">>]},
    {main, <<"README.md">>},
    {source_url, <<"https://github.com/omarjatoi/json-rpc">>}
]}.

{hex, [{doc, #{provider => ex_doc}}]}.
